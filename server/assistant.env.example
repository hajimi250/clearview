# 复制为 server/assistant.env 后填写；assistant.env 已被 server/.gitignore 忽略。
# 也可以直接设置同名环境变量，环境变量优先于本文件。
# 更换模型服务商时，把 URL 改为对应 OpenAI 兼容的 chat/completions 地址。
CLEARVIEW_ASSISTANT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
CLEARVIEW_ASSISTANT_API_KEY=sk-your-key-here
CLEARVIEW_ASSISTANT_MODEL=qwen-plus
CLEARVIEW_ASSISTANT_TIMEOUT_SECONDS=60

# 阿里云百炼业务空间专属域名（性能与稳定性更好，原域名仍可用）。
# 把 {WorkspaceId} 换成百炼控制台「业务空间详情」中的 ID（形如 llm-xxxx），
# 新加坡用 .ap-southeast-1.、中国香港用 .cn-hongkong.：
# CLEARVIEW_ASSISTANT_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
