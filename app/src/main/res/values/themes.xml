<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ClearView" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
    </style>

    <style name="Theme.ClearView.Splash" parent="Theme.ClearView">
        <item name="android:windowBackground">@color/brand_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
    </style>
</resources>
